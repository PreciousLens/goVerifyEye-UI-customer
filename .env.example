# Backend API base (no trailing slash).
# - Leave empty to use in-browser mocks.
# - Use `same-origin` (or `/`) for Vercel/local proxy to `/api/...` (avoids CORS).
# - Or set an absolute API origin, e.g. https://goverifeye-api.onrender.com
VITE_API_BASE_URL=

# Force mock even when VITE_API_BASE_URL is set
# VITE_USE_MOCK_API=true

# Optional store links on the landing download CTAs
# VITE_APP_STORE_URL=https://apps.apple.com/...
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/...
